# ctest: hooks/eboot.txt lists exactly the eboot offsets the host installs hooks on (src/render/capture.cpp).
# Run as: cmake -DSRC=<capture.cpp> -DLIST=<eboot.txt> -P check_hooks.cmake
file(READ "${SRC}" src)
file(STRINGS "${LIST}" lines)
set(want "")
string(REGEX MATCHALL "\n *\\{0x[0-9a-f]+, OBSERVER\\(" rows "${src}")
foreach(r ${rows})
  string(REGEX REPLACE ".*\\{0x([0-9a-f]+),.*" "\\1" a "${r}")
  list(APPEND want "${a}")
endforeach()
string(REGEX MATCH "kCursorUpdate = 0x([0-9a-f]+);" m "${src}")
list(APPEND want "${CMAKE_MATCH_1}")
set(have "")
foreach(l ${lines})
  string(REGEX REPLACE "#.*" "" l "${l}")
  string(STRIP "${l}" l)
  if(NOT l STREQUAL "")
    list(APPEND have "${l}")
  endif()
endforeach()
function(normalize out)
  set(res "")
  foreach(x ${ARGN})
    string(REGEX REPLACE "^0+([0-9a-f])" "\\1" x "${x}")
    list(APPEND res "${x}")
  endforeach()
  list(REMOVE_DUPLICATES res)
  list(SORT res)
  set(${out} "${res}" PARENT_SCOPE)
endfunction()
normalize(W ${want})
normalize(H ${have})
if(NOT W STREQUAL H)
  message(FATAL_ERROR "hooks/eboot.txt is out of step with capture.cpp\n  sources: ${W}\n  list:    ${H}")
endif()
list(LENGTH W n)
message(STATUS "hooks list matches the sources (${n} functions)")
